import os
import tkinter as tk
from PIL import Image, ImageTk
import arabic_reshaper
from bidi.algorithm import get_display

# دالة لتصحيح عرض النص العربي في Tkinter
def fix_arabic(text):
    reshaped_text = arabic_reshaper.reshape(text)
    bidi_text = get_display(reshaped_text)
    return bidi_text

root = tk.Tk()
root.title("HACKER PROTECT")
root.geometry("600x700")
root.config(background="red")

# 1. إظهار النص الأول بالإنجليزية
label1 = tk.Label(root, text="CYBER-SECURITY", bg="red", fg="white", font=("Arial", 16, "bold"))
label1.pack(pady=(10, 5))

# 2. إظهار النص العربي
arabic_text = "الى بغيتي المعلومات ديالك يبقاو في امان دير الكود"
label2 = tk.Label(root, text=fix_arabic(arabic_text), bg="red", fg="white", font=("Arial", 14))
label2.pack(pady=(5, 10))

# 3. جلب وعرض الصورة
script_dir = os.path.dirname(os.path.abspath(__file__))

image_path = os.path.join(script_dir, "logo.jpeg")  # اسم ملف الصورة
try:
    img = Image.open(image_path)
    # تعديل حجم الصورة لتناسب الواجهة
    img = img.resize((250, 250))
    photo = ImageTk.PhotoImage(img)
    
    image_label = tk.Label(root, image=photo, bg="red")
    image_label.image = photo  # الاحتفاظ بمرجع الصورة
    image_label.pack(pady=10)
except Exception as e:
    print("خطأ في تحميل الصورة:", e)

# 4. مربع ادخال النص (Entry)
entry = tk.Entry(root, width=40, font=("Arial", 12))
entry.pack(pady=10)

# 5. الزر (Button)
b = tk.Button(root, text="code", font=("Arial", 12, "bold"))
b.pack(pady=(10, 20))


tk.Label(root, text="gmail", bg="red", fg="white").pack(side="bottom", anchor="sw", padx=100, pady=100)


class LoginApp:
    def __init__(self, root: tk.Tk):
        self.root = root
        self.mode = "login"
        self.show_password = False
        self.logo_image = None

        root.title("تسجيل الدخول")
        root.geometry("440x650")
        root.minsize(360, 560)
        root.configure(bg="white")

# 1. إنشاء النافذة الأساسية
root = tk.Tk()

# 2. استدعاء الكلاس وتمرير النافذة له
app = LoginApp(root)

# 3. تشغيل الحلقة الرئيسية
root.mainloop()

